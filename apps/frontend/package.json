{
  "name": "@ordiola/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wireit",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --watch"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "files": [
        "src/**",
        "static/**",
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts"
      ],
      "output": [
        "build/**"
      ]
    }
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lucide/svelte": "^1.23.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-opener": "^3.0.0-alpha.3",
    "@telaion/ui": "^0.1.1",
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "codemirror": "^6.0.2",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^3.0.0-alpha.5",
    "@types/node": "^22.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wireit": "^0.15.0"
  }
}
